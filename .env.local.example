# Copy this file to .env.local and fill in what you have.
# Every line is optional for local development: with nothing set, the site runs
# with a dev sign-in, simulated billing, and a scripted "practice" guide.
# See SETUP.md for where each value comes from.

# --- Site -------------------------------------------------------------------
# Public address of the site, no trailing slash (e.g. https://narrativetheory.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Price shown on the pricing page. Must match the Stripe price (display only).
NEXT_PUBLIC_PRICE_LABEL=$12

# --- Anthropic (the AI guide) -----------------------------------------------
# API key from console.anthropic.com. Without it the guide runs in practice mode.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: model for guided sessions (default claude-opus-5-5; claude-sonnet-5-5 is cheaper).
NT_SESSION_MODEL=
# Optional: model for the Program (default claude-opus-5-5).
NT_PROGRAM_MODEL=
# Optional: model that takes over if the main model declines a request on safety grounds (default claude-opus-4-8).
NT_FALLBACK_MODEL=
# Optional: set to 1 to force scripted practice mode even when an API key is set.
NT_PRACTICE_AI=
# Comma-separated emails allowed to use the Studio authoring tool (/studio).
NT_ADMIN_EMAILS=

# --- Supabase (accounts + database) ----------------------------------------
# Project URL, from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key, same page. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret key, same page. Server only — never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (membership billing) --------------------------------------------
# Secret key, from Stripe > Developers > API keys (sk_live_... or sk_test_...).
STRIPE_SECRET_KEY=
# Price id of the monthly membership price (price_...).
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
